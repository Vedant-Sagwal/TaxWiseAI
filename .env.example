# Create a free Groq API key at https://console.groq.com/keys
# Never expose this value in browser code or commit it to Git.
GROQ_API_KEY=

# A conservative application limit. Set this below Groq's account quota.
DAILY_CHAT_LIMIT=20

# Set after creating a Supabase project. These are used in the RAG increment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Enables the “verify current information” chat mode using Tavily.
# Results are restricted to official Indian government tax sources.
TAVILY_API_KEY=

# Optional hybrid RAG. Existing PDFs must be re-uploaded after enabling embeddings.
# This project uses text-embedding-3-small at 1536 dimensions.
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional cross-encoder reranking of fused candidates. Default model is multilingual.
JINA_API_KEY=
RERANKER_MODEL=jina-reranker-v2-base-multilingual

# Protects the offline/CI RAG evaluation endpoint. Do not expose in browser code.
EVALUATION_API_KEY=

# Server-only authorization for uploading trusted, official PDFs to the shared library.
ADMIN_UPLOAD_KEY=
